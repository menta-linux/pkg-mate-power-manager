#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		-Denable-wayland=true \
		-Dapplets=true \
		-Dapplets-in-process=true \
		-Dappindicator=enabled \
		-Dgnome-keyring=false \
		-Dlibsecret=true \
		-Denable-tests=false

override_dh_missing:
	dh_missing --fail-missing

override_dh_install:
	dh_install
	# Ubuntu MATE enables indicators by default which include indicator-power
	# so override mate-power-manager defaults accordingly.
ifeq ($(shell dpkg-vendor --is Ubuntu && echo yes),yes)
	dh_install -pmate-power-manager-common debian/25_mate-power-manager-ubuntu.gschema.override /usr/share/glib-2.0/schemas/
endif

override_dh_installchangelogs:
	dh_installchangelogs NEWS

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
